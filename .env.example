# Application Settings
APP_NAME=YouExpress API
APP_VERSION=1.0.0
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://youexpress_user:youexpress_pass@postgres:5432/youexpress_db
DATABASE_ECHO=False

# API Documentation
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json

# CORS Configuration
CORS_ORIGINS=["*"]
CORS_CREDENTIALS=True
CORS_METHODS=["GET", "POST", "PUT", "DELETE"]
CORS_HEADERS=["*"]
